{
  "name": "qvill",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@qvill/web",
    "dev:api": "npm run start:dev --workspace=@qvill/api",
    "dev:mobile": "npm run start --workspace=@qvill/mobile",
    "build:web": "npm run build --workspace=@qvill/web",
    "package:mac": "npm run build:web && npm run prepare:desktop && npm run dist:mac --workspace=@qvill/desktop",
    "prepare:desktop": "node scripts/prepare-desktop.mjs"
  }
}
